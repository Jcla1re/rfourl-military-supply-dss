# ==========================================================================
# RfourL DSS -- PRODUCTION settings template.
# Copy to .env ON THE SERVER ONLY (never commit the real .env), then fill in
# every CHANGE_ME value. Keep your local development .env as it is.
# ==========================================================================

CI_ENVIRONMENT = production

# Your real HTTPS address (the domain must have a valid SSL certificate).
app.baseURL = 'https://CHANGE_ME.example.com/'
app.forceGlobalSecureRequests = true

# Cookies are only sent over HTTPS in production.
cookie.secure = true
cookie.samesite = 'Lax'

# --- Database: use a dedicated limited user, NEVER root -------------------
# Run once as the MySQL admin:
#   CREATE USER 'rfourl_app'@'localhost' IDENTIFIED BY 'CHANGE_ME_STRONG_PASSWORD';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON rfourl_dss.* TO 'rfourl_app'@'localhost';
#   (Use a separate admin account for migrations: needs CREATE/ALTER/INDEX.)
database.default.hostname = localhost
database.default.database = rfourl_dss
database.default.username = rfourl_app
database.default.password = CHANGE_ME_STRONG_PASSWORD
database.default.DBDriver = MySQLi
database.default.port = 3306

# Generate with:  php spark key:generate
encryption.key =

# Real SMTP so password-reset codes are emailed (port 587 with TLS).
email.protocol = smtp
email.SMTPHost = CHANGE_ME
email.SMTPUser = CHANGE_ME
email.SMTPPass = CHANGE_ME
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = CHANGE_ME
email.fromName = 'RfourL Military Supply'

# ML service: keep it on localhost / a private network, never public.
# Run it with gunicorn (see Procfile). Do NOT set FLASK_DEBUG in production.
ML_SERVICE_URL = http://127.0.0.1:5001

# The server's writable/ folder (cache, session, logs) must be writable by
# the web server user, otherwise login lockout falls back to weaker storage.
