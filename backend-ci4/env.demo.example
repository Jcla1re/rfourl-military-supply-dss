# Demo site settings (demo mode). Add these to the demo copy's .env, next to its own database settings.
# Demo mode is OFF unless DEMO_MODE = true; the live site never needs any of these.
# See the "Demo site" section of the README.

# The demo copy must use its OWN database, and the name must contain "demo":
# database.default.database = rfourl_demo

DEMO_MODE = true
DEMO_MAIL_TO = ourteam@gmail.com           # every demo email goes here (as ourteam+alias@gmail.com per account)
DEMO_OWNER_PASSWORD = change-me
DEMO_STAFF_PASSWORD = change-me-too        # must differ from every other staff password (staff login is password-only)
DEMO_SUPPLIER_PASSWORD = change-me-three
DEMO_SHOW_CREDENTIALS = true               # show the demo logins on the login pages
DEMO_RESET_TIME = '12:00 AM'               # text for the banner only; the real time is the cron job

# Only if mysqldump / mysql are not on the PATH (typical on Windows):
# DEMO_MYSQLDUMP_PATH = C:\xampp\mysql\bin\mysqldump.exe
# DEMO_MYSQL_PATH = C:\xampp\mysql\bin\mysql.exe
